{
  "manifest_schema_version": 3,
  "sdk_version": "5.13.0",
  "app_id": "keragon-connector",
  "version": "0.1.0",
  "name": "Keragon",
  "description": "Two-way webhook bridge between Imperal and Keragon, the HIPAA-compliant healthcare automation platform. Fire any number of named Keragon workflows from Imperal by POSTing to their HTTP Webhook Trigger URLs, and receive callbacks a Keragon workflow's HTTP Client action step sends back into Imperal -- plus bulk fan-out, delivery history, and templated healthcare event payloads Imperal builds on top. Keragon exposes no general workflow-management API (see this app's own notes), so this is deliberately a webhook bridge, not a CRUD connector.",
  "icon": "icon.svg",
  "actions_explicit": true,
  "system": false,
  "capabilities": [
    "keragon:read",
    "keragon:write"
  ],
  "tools": [
    {
      "name": "create_outgoing_bridge",
      "description": "Register a new named bridge to a Keragon workflow -- paste the workflow's HTTP Webhook Trigger URL (from the trigger step's setup screen inside Keragon) and give it a short label so you can fire it by name later with send_bridge_event.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "keragon.outgoing_bridge.created"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "name": {
            "description": "Short label for this bridge, e.g. 'New patient intake'.",
            "title": "Name",
            "type": "string"
          },
          "webhook_url": {
            "description": "The Keragon workflow's HTTP Webhook Trigger URL, copied from the trigger step's setup screen inside Keragon.",
            "title": "Webhook Url",
            "type": "string"
          },
          "description": {
            "default": "",
            "description": "Optional note on what this workflow does or when it fires.",
            "title": "Description",
            "type": "string"
          }
        },
        "required": [
          "name",
          "webhook_url"
        ],
        "title": "CreateOutgoingBridgeParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "created_at": {
            "default": "",
            "title": "Created At",
            "type": "string"
          },
          "has_url": {
            "default": false,
            "title": "Has Url",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "OutgoingBridgeEntry",
        "type": "object"
      },
      "event": "keragon-connector.create_outgoing_bridge",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "keragon"
    },
