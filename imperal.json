    {
      "name": "send_bridge_event",
      "description": "Fire one configured Keragon workflow right now by POSTing a JSON payload to its HTTP Webhook Trigger URL. Run create_outgoing_bridge first if you haven't registered this workflow yet.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "keragon.bridge.sent"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "bridge_id": {
            "description": "Which bridge (Keragon workflow trigger) to fire, from list_outgoing_bridges.",
            "title": "Bridge Id",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "description": "Arbitrary JSON payload to POST to that workflow's HTTP Webhook Trigger URL -- e.g. patient/appointment fields the workflow expects.",
            "title": "Payload",
            "type": "object"
          }
        },
        "required": [
          "bridge_id"
        ],
        "title": "SendBridgeEventParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "delivered": {
            "title": "Delivered",
            "type": "boolean"
          },
          "status_code": {
            "default": 0,
            "title": "Status Code",
            "type": "integer"
          },
          "detail": {
            "default": "",
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "delivered"
        ],
        "title": "WebhookDeliveryResult",
        "type": "object"
      },
      "event": "keragon-connector.send_bridge_event",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "keragon"
    },
    {
      "name": "bulk_send_bridge_event",
      "description": "Fire the SAME payload to several configured Keragon workflows in one call -- e.g. notify both 'New patient intake' and 'Slack alert' bridges at once. Continues past per-bridge failures and reports each outcome. This is an Imperal-side convenience -- Keragon itself has no bulk-trigger endpoint.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "keragon.bridge.sent"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "bridge_ids": {
            "description": "Which bridges to fire, from list_outgoing_bridges. 1-20 per call.",
            "items": {
              "type": "string"
            },
            "title": "Bridge Ids",
            "type": "array"
          },
          "payload": {
            "additionalProperties": true,
            "description": "Same JSON payload POSTed to every listed bridge's Keragon workflow trigger.",
            "title": "Payload",
            "type": "object"
          }
        },
        "required": [
          "bridge_ids"
        ],
        "title": "BulkSendBridgeEventParams",
        "type": "object"
      },
      "return_schema": {
        "$defs": {
          "BulkDeliveryItem": {
            "properties": {
              "bridge_id": {
                "title": "Bridge Id",
                "type": "string"
              },
              "name": {
                "default": "",
                "title": "Name",
                "type": "string"
              },
              "delivered": {
                "title": "Delivered",
                "type": "boolean"
              },
              "status_code": {
                "default": 0,
                "title": "Status Code",
                "type": "integer"
              },
              "detail": {
                "default": "",
                "title": "Detail",
                "type": "string"
              }
            },
            "required": [
              "bridge_id",
              "delivered"
            ],
            "title": "BulkDeliveryItem",
            "type": "object"
          }
        },
        "properties": {
          "results": {
            "items": {
              "$ref": "#/$defs/BulkDeliveryItem"
            },
            "title": "Results",
            "type": "array"
          },
          "sent": {
            "default": 0,
            "title": "Sent",
            "type": "integer"
          },
          "total": {
            "default": 0,
            "title": "Total",
            "type": "integer"
          }
        },
        "title": "BulkDeliveryResult",
        "type": "object"
      },
      "event": "keragon-connector.bulk_send_bridge_event",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "keragon"
